# ==========================================================
#  文物精灵 · 忽略规则
#  原则：代码与素材入库；密钥、本机调试产物、超大原始存档不入库
# ==========================================================

# ---------- 1. 密钥与私密配置（绝不入库） ----------
# 页面「🔑 接入 AI 大模型」填的 Key 只存本机 localStorage，不落盘；
# 若你手动把 Key 存成文件，放这两个路径即可自动忽略。
tools/ident_key.txt
tools/volc_key.txt
tools/_secrets.py
.env
.env.local
*.key
*.pem
id_rsa*

# ---------- 2. 本机调试产物 ----------
_debug/
__pycache__/
存档/
*.py[cod]
# 本地 HTTPS 证书：含本机局域网 IP，换台机器就得重签，跑 tools/mk_tls.py 生成
certs/
# LSA 向量缓存：删掉后首次启动会按 kb_index.json 自动重建，不必入库（约 3.5 MB）
mcp/.vectors.npz
*.egg-info/

# ---------- 3. 原始素材存档（2GB+，单独归档，不随代码走） ----------
文物精灵-素材存档/

# ---------- 4. 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 5. 打包中间物 ----------
*.tar.gz
*.zip
node_modules/

# 注意：js/ident-direct.js 是页面依赖的正式脚本（index.html 会加载它），
#      经检查不含任何密钥，因此不再忽略，否则克隆后会出现 404。

# ---------- 6. 语音音频（生成产物，约 26 MB，不入库） ----------
# 292 段 mp3 由 tools/gen_voice.py 按 audio/index.json 批量生成；
# 服务端 /api/tts 也会按同一份索引现场合成，故仓库只保留 audio/index.json。
audio/*/

# ---------- 7. 起源视频：仅一件超 GitHub 单文件 100MB 上限 ----------
# 五星出中国.mp4 约 263 MB，超过 GitHub 单文件 100 MB 硬限制，本机也未装 Git LFS。
# 该片已完整部署到线上站点；仓库收录其余 7 部。离线放映时把这一部放回同目录即可。
文物精灵的起源视频/五星出中国.mp4
# 卡面设计过程中的 AI 参考图，属本机中间产物，不随代码入库
文物溯源/_ref/

# ---------- 备份/临时 ----------
*.bak

# ---------- 其它 ----------
.opencode/
tools/bridge.log
*.log

# ---------- 8. 本机生成的中间图（成品入库，原图/截图不入库） ----------
# AI 生成的原图（35MB）与抠图前的底图，成品在 装饰/vn_bg_*.png
装饰/vn_bg_generated/
精灵/_raw/
# 素材参考截图
shiyilu/
# tools 下的临时截图（脚本本身仍入库）
tools/_*.png

# ---------- 9. 2026-11-10 整理 ----------
# 成就小像的合成底纹（2 张 ImageGen 原图，5.3MB）；成品 ach_*.jpg 已入库，底纹不入库
成就/_plates/
# 片头/海报实验素材（26 个 AI 生成片段与参考图，52MB），成品在 装饰/ 与 展望/
修复验收/foil/
# 主线流程图预览的临时产出（sed 生成，跑一次就丢）
_vn_test.html
# 一次性截图/定位脚本：验证时用完即弃，只保留可复用的校验与推送工具
tools/_shot_*.py
tools/_seek_*.py
tools/_find_starter.py
tools/_dump_st.js
tools/_verify_*.py

# ---------- 10. 2026-11-13 文档排版收尾 ----------
# 文档排版排查的中间截图目录（脚本本身仍入库）
tools/_shots/
tools/_audit_shots/
# 早期用 Word COM 的 .ps1 导出脚本：ExecutionPolicy 下跑不通，已由 tools/export_techdoc_pdf.py 取代
tools/_export_pdf*.ps1
# 一次性文档补丁脚本（改动已落到 docx，保留生成器与导出器即可）
tools/_fix_v19_*.py
