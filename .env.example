# ==========================================================
#  文物精灵 · 环境变量模板
#  用法：复制为 .env（已在 .gitignore 中，绝不入库），按需填写
#  cp .env.example .env
# ==========================================================

# ---------- 1. 站点演示账号（登录面板用） ----------
# 前端只保存「口令的加盐哈希」（FNV-1a），源码里不出现明文口令。
# 修改口令：在浏览器控制台执行 hashPass("wwjl", "你的新口令") 取前 8 位，
#          填到 js/cloud-ai.js 的 ACCOUNTS 与 js/app.js 的 AUTH_DEMOS。
DEMO_EMAIL=you@example.com
DEMO_PASS=

# ---------- 2. AI 能力（二选一） ----------
# 方式 A（推荐，开箱即用）：不填任何密钥，走站点内置云端中转
# 方式 B（自备）：在页面「🔑 接入 AI 大模型」里填自己的 Key，只存在本机 localStorage
ZHIPU_API_KEY=
ARK_API_KEY=
# 自定义可选
AI_PROVIDER=zhipu
AI_MODEL=glm-4-flash

# ---------- 3. 本地 AI 小桥（tools/ident_cloud.py，可选） ----------
# 小桥只监听 127.0.0.1，并校验 Origin（外部网页会被 403）
IDENT_BRIDGE_HOST=127.0.0.1
IDENT_BRIDGE_PORT=8898

# ---------- 4. 部署到自己的服务器（可选） ----------
# 注意：SSH 口令只放环境变量，不要写进任何脚本或提交到仓库
SSH_HOST=
SSH_USER=root
SSH_PASS=
REMOTE_DIR=/opt/relic

# ---------- 5. 本地预览端口 ----------
PORT=8000
